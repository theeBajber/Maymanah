# PostgreSQL connection strings.
#
# Neon exposes two endpoints per branch: a pooled endpoint (used at runtime to
# survive serverless concurrency) and a direct endpoint (used by Prisma for
# migrations, which must bypass the pooler).
#
# The pooled hostname carries a "-pooler" label; the direct one does not.

# Pooled endpoint, used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct endpoint, required by Prisma to run migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional. Only needed when applying migrations that require a shadow database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/shadowdb?sslmode=require&channel_binding=require"

# Absolute origin of this deployment. Used to build the links in transactional
# email, so a wrong value here sends people to a page that does not exist.
APP_URL="http://localhost:3000"
