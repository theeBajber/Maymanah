generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// An account. Every account authenticates with an email address and a
/// password; there is no third-party sign-in, so no account or session table
/// is needed to store identities from an external provider.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole  @default(STUDENT)

  /// Whether this account must supply a one-time code in addition to its
  /// password. The code itself lives in TwoFactorCode.
  twoFactorEnabled Boolean @default(false)

  image  String?
  gender String?
  xp     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  twoFactorCodes      TwoFactorCode[]
  loginSessions       LoginSession[]
  profile             Profile?
  ustadhProfile       UstadhProfile?
  availabilities      Availability[]
  teacherMentorships  Mentorship[]     @relation("TeacherMentorships")
  studentMentorships  Mentorship[]     @relation("StudentMentorships")
  teacherAppointments Appointment[]    @relation("TeacherAppointments")
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  submissions         Submission[]
  courseReviews       CourseReview[]
  bookmarks           Bookmark[]

  @@index([role])
}

/// A single-use secret sent to an email address, either to confirm the address
/// belongs to the person registering or to authorise a password reset.
///
/// Only the hash is stored. A database disclosure then yields no usable token,
/// because the plaintext exists solely in the recipient's inbox.
model VerificationToken {
  id         String              @id @default(cuid())
  email      String
  tokenHash  String
  purpose    VerificationPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@unique([email, purpose, tokenHash])
  @@index([email, purpose])
  @@index([expiresAt])
}

/// A one-time code for two-factor authentication.
///
/// `attempts` is incremented on every check, and the code is dead once the cap
/// is reached. Guessing is therefore bounded by the cap rather than by the
/// expiry window alone: a six-digit code has a million possibilities, which is
/// few enough to enumerate within ten minutes.
model TwoFactorCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// A record of one signed-in device.
///
/// Session cookies are self-contained, so revoking one in the database would
/// have no effect unless every request checks it. This table is what makes
/// "sign out this device" actually end that session instead of merely removing
/// it from a list.
model LoginSession {
  id         String   @id @default(cuid())
  userId     String
  deviceName String
  ipAddress  String
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

/// A fixed-window request counter, one row per limit key.
///
/// Counters live in the database because a serverless runtime discards process
/// memory between invocations, so an in-memory map would reset on every request
/// and limit nothing. Each attempt costs one write, which is the trade for not
/// requiring a separate cache service to be provisioned and paid for.
///
/// Rows are removed by `expiresAt` once their window can no longer be counted,
/// so the table stays proportional to recent activity rather than growing
/// without bound.
model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}

/// Everything about an account that is not authentication.
///
/// Kept apart from User so that signing in never needs to read preferences,
/// and so that deleting preferences never risks the credentials they sit next
/// to. A row is created on first save rather than at registration, which means
/// its absence simply means defaults.
model Profile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  bio                String?
  phone              String?
  country            String?
  timezone           String  @default("Africa/Nairobi")
  quranLevel         String?
  theme              String  @default("system")
  language           String  @default("en")
  quranFont          String  @default("default")
  emailNotifications Boolean @default(true)
  studyReminders     Boolean @default(true)
  reminderTime       String  @default("09:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A teacher's standing on the platform.
///
/// Approval is a human decision recorded here, not a role. A teacher account
/// exists before it is approved, and an unapproved teacher simply cannot be
/// paired with students yet. Availability for new pairings is a separate
/// switch, so an approved teacher can pause without losing their standing.
model UstadhProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  isApproved           Boolean   @default(false)
  rejectedAt           DateTime?
  bio                  String?
  qualifications       String?
  ijazah               String?
  qiraah               String?
  availableForTeaching Boolean   @default(false)
  reliabilityScore     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isApproved])
}

/// One recurring weekly window in which a user can meet.
///
/// Days are numbers with Sunday as zero, and times are 24-hour strings, so a
/// slot is comparable without parsing dates. Only recurring slots live here;
/// one-off sessions belong to the scheduling phase with the appointments that
/// created them.
model Availability {
  id           String    @id @default(cuid())
  userId       String
  dayOfWeek    Int
  startTime    String
  endTime      String
  isRecurring  Boolean   @default(true)
  specificDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MentorshipStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

/// What a session is for. A daily memorisation slot is short; a review
/// session is long; anything else is booked explicitly.
enum AppointmentSessionType {
  DAILY_HIFDH
  MURAJA
  EXTRA
}

/// An ongoing teacher-student pairing.
///
/// One active pairing per teacher and student. Sessions are booked against the
/// pairing rather than against either person directly, so ending the pairing
/// ends future sessions without touching either account.
model Mentorship {
  id        String           @id @default(cuid())
  teacherId String
  studentId String
  status    MentorshipStatus @default(ACTIVE)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  teacher        User            @relation("TeacherMentorships", fields: [teacherId], references: [id], onDelete: Cascade)
  student        User            @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  recurringSlots RecurringSlot[]

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
}

/// One booked session.
///
/// Times are absolute rather than relative to a slot, so rescheduling moves
/// the session without rewriting the pattern it came from. A session belongs
/// to a pairing, and ending the pairing ends its future sessions.
model Appointment {
  id           String                 @id @default(cuid())
  mentorshipId String
  teacherId    String
  title        String?
  description  String?
  startTime    DateTime
  endTime      DateTime?
  meetingUrl   String?
  status       AppointmentStatus      @default(SCHEDULED)
  sessionType  AppointmentSessionType @default(DAILY_HIFDH)
  startedAt    DateTime?
  endedAt      DateTime?
  joinedAt     DateTime?
  missed       Boolean                @default(false)
  surahNumber  Int?
  verseNumber  Int?

  createdAt DateTime @default(now())

  mentorship  Mentorship   @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  teacher     User         @relation("TeacherAppointments", fields: [teacherId], references: [id], onDelete: Cascade)
  sessionPlan SessionPlan?

  @@index([mentorshipId])
  @@index([teacherId])
  @@index([startTime])
}

/// One recurring session in a pairing's weekly pattern.
///
/// Duration is in minutes: fifteen for a daily memorisation slot, sixty for a
/// review. Only one slot of each type per day, so two identical sessions can
/// never be generated for the same morning.
model RecurringSlot {
  id           String                 @id @default(cuid())
  mentorshipId String
  type         AppointmentSessionType
  dayOfWeek    Int
  startTime    String
  duration     Int
  createdAt    DateTime               @default(now())

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@unique([mentorshipId, type, dayOfWeek])
  @@index([mentorshipId])
}

/// What a session is meant to cover, as a range of verses.
///
/// Set by the teacher before the session. One plan per session, replaced
/// rather than edited, so the record of what was intended survives even when
/// the session itself covers something else.
model SessionPlan {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  fromSurah     Int
  fromVerse     Int
  toSurah       Int
  toVerse       Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

enum CourseCategory {
  Quran
  Fiqh
  History
  Arabic
  Aqeedah
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  ESSAY
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// A course: an ordered set of lessons, optionally examined and reviewed.
///
/// Visibility is two switches, not one. Published means students can see it;
/// active means it is currently taught. An unfinished course stays unpublished
/// while it is written, and a retired one is deactivated without deleting the
/// records of everyone who took it.
model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  category      CourseCategory
  image         String?
  enrollmentKey String?        @unique
  isPublished   Boolean        @default(true)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  enrollments Enrollment[]
  lessons     Lesson[]
  exams       Exam[]
  reviews     CourseReview[]
}

/// One unit of teaching inside a course.
///
/// Order is an explicit number rather than creation order, so lessons can be
/// rearranged without recreating them. Content is markdown rendered as
/// components, never raw HTML, so there is no markup to sanitise.
model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String?
  videoUrl    String?
  audioUrl    String?
  order       Int
  duration    Int?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam           Exam?
  lessonProgress LessonProgress[]

  @@index([courseId])
}

/// One student's passage through a course.
///
/// Progress is a cached percentage, recomputed when a lesson completes, so
/// listing courses never counts lessons per row. One row per student and
/// course: enrolling twice returns the existing row rather than starting over.
model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now())
  passedAt    DateTime?
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

/// One student's completion of one lesson.
///
/// One row per student and lesson. Completing twice updates the row rather
/// than duplicating it, so progress arithmetic always has one value to read.
model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  completed   Boolean   @default(false)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

/// An assessment, attached to a course or to one lesson.
///
/// Windows are optional: an untimed quiz has neither, and a missing window
/// means open rather than closed. Publishing gates visibility separately from
/// existence, so an exam can be written before it is offered.
model Exam {
  id               String    @id @default(cuid())
  courseId         String
  lessonId         String?   @unique
  title            String
  description      String?
  examType         ExamType  @default(QUIZ)
  durationMinutes  Int       @default(60)
  totalMarks       Float     @default(100)
  passMark         Float     @default(50)
  startTime        DateTime?
  endTime          DateTime?
  isPublished      Boolean   @default(false)
  shuffleQuestions Boolean   @default(true)
  allowReview      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions   Question[]
  submissions Submission[]

  @@index([courseId])
}

/// One question in an exam.
///
/// Multiple-choice options are a plain string array, and the correct answer
/// names the index into it. Short answers and essays carry their expected
/// answer as text for a human marker, since no automated grading exists.
model Question {
  id            String       @id @default(cuid())
  examId        String
  questionText  String
  questionType  QuestionType @default(MCQ)
  options       Json?
  correctAnswer String?
  marks         Float        @default(1)
  orderIndex    Int          @default(0)
  explanation   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([examId])
}

/// One student's attempt at an exam.
///
/// Attempts are numbered, so a retake starts a new row rather than overwriting
/// the old one. Grading happens on submission: choice questions are marked
/// immediately, written ones wait for a marker.
model Submission {
  id            String           @id @default(cuid())
  examId        String
  studentId     String
  status        SubmissionStatus @default(IN_PROGRESS)
  totalScore    Float?
  attemptNumber Int              @default(1)
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

/// One answer inside a submission.
///
/// One row per submission and question. Answering twice updates the row, so a
/// changed mind replaces the earlier answer rather than adding a second one.
model Answer {
  id             String   @id @default(cuid())
  submissionId   String
  questionId     String
  answerText     String?
  selectedOption Int?
  isCorrect      Boolean?
  score          Float?
  answeredAt     DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
}

/// One student's rating of a course.
///
/// One row per student and course, so re-rating replaces the earlier verdict.
/// Only someone enrolled can review, since a rating from a stranger measures
/// nothing.
model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

/// One saved verse with an optional note.
///
/// Unique per user, chapter, and verse, so saving twice returns the existing
/// row rather than duplicating it.
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  surah     Int
  ayah      Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surah, ayah])
  @@index([userId])
}
